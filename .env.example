# =============================================================================
# LLM Provider — pick one: anthropic | openai | gemini | groq | ollama
# =============================================================================
LLM_PROVIDER=gemini

# (Optional) Override the provider's default model — leave empty to use default
# anthropic: claude-sonnet-4-6
# openai:    gpt-4o-mini
# gemini:    gemini-2.0-flash
# groq:      llama-3.3-70b-versatile
# ollama:    llama3
LLM_MODEL=

# -----------------------------------------------------------------------------
# Anthropic Claude (PAID — pay-as-you-go)
# Get key: https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_key_here

# -----------------------------------------------------------------------------
# OpenAI GPT (PAID — pay-as-you-go)
# Get key: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_key_here

# -----------------------------------------------------------------------------
# Google Gemini (FREE TIER — 15 req/min, 1500 req/day)
# Get key: https://aistudio.google.com/apikey
# Install: pip install -e ".[gemini]"
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# Groq (FREE TIER — generous, llama-3.3-70b free)
# Get key: https://console.groq.com/keys
# Install: pip install -e ".[groq]"
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# Ollama (LOCAL, FREE — no key, but uses local RAM/CPU)
# 1. Install Ollama: https://ollama.com
# 2. Pull model: ollama pull llama3 (or gemma2:2b for low-spec machines)
# 3. Set LLM_PROVIDER=ollama
# Install: pip install -e ".[ollama]"
# -----------------------------------------------------------------------------

# =============================================================================
# Vector Store
# =============================================================================
# CHROMA_PERSIST=true  → save to disk, can reload after restart
# CHROMA_PERSIST=false → keep in RAM only, lost on app close (no .chroma/ folder)
CHROMA_PERSIST=false
CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION_NAME=documents

# =============================================================================
# Embedding model (runs locally, free)
# Use a multilingual model if your docs are in non-English languages:
#   paraphrase-multilingual-MiniLM-L12-v2  (50+ languages, 120MB)
#   intfloat/multilingual-e5-base          (better quality, 280MB)
#   BAAI/bge-m3                            (top quality multilingual, 568MB)
# =============================================================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
