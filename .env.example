# =============================================================================
# LLM Provider — chọn 1 trong: anthropic | openai | gemini | groq | ollama
# =============================================================================
LLM_PROVIDER=gemini

# (Tùy chọn) Override model mặc định của provider — bỏ trống để dùng default
# anthropic: claude-sonnet-4-6
# openai:    gpt-4o-mini
# gemini:    gemini-2.0-flash
# groq:      llama-3.3-70b-versatile
# ollama:    llama3
LLM_MODEL=

# -----------------------------------------------------------------------------
# Anthropic Claude (TRẢ PHÍ — pay-as-you-go)
# Lấy key: https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_key_here

# -----------------------------------------------------------------------------
# OpenAI GPT (TRẢ PHÍ — pay-as-you-go)
# Lấy key: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_key_here

# -----------------------------------------------------------------------------
# Google Gemini (FREE TIER — 15 req/min, 1500 req/day)
# Lấy key: https://aistudio.google.com/apikey
# Cài: pip install -e ".[gemini]"
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# Groq (FREE TIER — rất generous, llama-3.3-70b miễn phí)
# Lấy key: https://console.groq.com/keys
# Cài: pip install -e ".[groq]"
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# Ollama (LOCAL, MIỄN PHÍ — không cần key, nhưng tốn RAM/CPU)
# 1. Cài Ollama: https://ollama.com
# 2. Pull model: ollama pull llama3 (hoặc gemma2:2b cho máy yếu)
# 3. Đặt LLM_PROVIDER=ollama
# Cài: pip install -e ".[ollama]"
# -----------------------------------------------------------------------------

# =============================================================================
# Vector Store
# =============================================================================
CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION_NAME=documents

# =============================================================================
# Embedding model (chạy local, miễn phí)
# =============================================================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
